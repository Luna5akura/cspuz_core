#!/usr/bin/env python3

# A simple wrapper for emcc that changes the output file extension to .js

import argparse
import os
import subprocess


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("-o", type=str, required=True)
    overwritten_args, extra_args = parser.parse_known_args()

    orig_output = overwritten_args.o
    root, ext = os.path.splitext(orig_output)
    assert ext in [".wasm", ".js"]
    output = root + ".js"

    if os.path.basename(root) in ["cspuz_solver_backend", "cspuz_solver_backend_wasm"]:
        extra_args += [
            "--no-entry",
            "-s",
            "EXPORTED_FUNCTIONS=_solve_problem,_solve_problem_with_forced_lines,_enumerate_answers_problem,_solve_custom_travelline,_prepare_input_buffer",
        ]

    # この環境の wasm-ld は --no-stack-first を受け付けない。
    # emcc は -O1 以上で内部的に --no-stack-first を渡すため、
    # 最適化フラグを除去して回避する (コード最適化は rustc 側で行われる)
    extra_args = [a for a in extra_args if not a.startswith("-O")]

    args = ["emcc", "-o", output] + extra_args
    subprocess.check_call(args)


if __name__ == "__main__":
    main()
